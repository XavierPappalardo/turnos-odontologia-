{
  "name": "turnos-odontologia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MVP turnos odontologia - backend (C-04 agenda anti-solapamiento)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env --watch dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
