# Ejemplo de entorno backend — SOLO nombres + valores de ejemplo NO secretos (R15).
# No contiene credenciales ni tokens reales. Ningún secreto hardcodeado en código:
# una variable requerida faltante hace fallar el arranque (fail-fast, design D2).

# Puerto HTTP del servidor (entero 0..65535; 0 = puerto efímero del SO).
PORT=3000

# Ruta del archivo SQLite. Usar ":memory:" para una base efímera en memoria.
# El archivo debe vivir en un directorio existente; la raíz del backend sirve
# y `*.db` está gitignored.
DATABASE_PATH=./turnos.db

# Entorno de ejecución: development | production | test.
NODE_ENV=development

# Secreto HMAC para JWT (mínimo 32 caracteres). NUNCA commitear el valor real:
# va en `.env` (gitignored). El valor de abajo es de ejemplo y no sirve en prod.
JWT_SECRET=cambiar-por-un-secreto-real-de-al-menos-32-caracteres

# Vida útil de tokens (segundos). Defaults: access 900 (15 min), refresh 604800 (7 días).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Rate limit del login (intentos por ventana, por IP+email).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Contraseña de los usuarios ficticios del seed (mínimo 8 caracteres).
# Solo se usa con `npm run seed`; nunca se commitea un valor real.
SEED_PASSWORD=cambiar-esta-clave-ficticia
