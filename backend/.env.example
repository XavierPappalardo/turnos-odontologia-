# Ejemplo de entorno backend — SOLO nombres + valores de ejemplo NO secretos (R15).
# No contiene credenciales ni tokens reales. Ningún secreto hardcodeado en código:
# una variable requerida faltante hace fallar el arranque (fail-fast, design D2).

# Puerto HTTP del servidor (entero 0..65535; 0 = puerto efímero del SO).
PORT=3000

# Ruta del archivo SQLite. Usar ":memory:" para una base efímera en memoria.
# El archivo debe vivir en un directorio existente; la raíz del backend sirve
# y `*.db` está gitignored.
DATABASE_PATH=./turnos.db

# Entorno de ejecución: development | production | test.
NODE_ENV=development

# Secreto HMAC para JWT (mínimo 32 caracteres). NUNCA commitear el valor real:
# va en `.env` (gitignored). El valor de abajo es de ejemplo y no sirve en prod.
JWT_SECRET=cambiar-por-un-secreto-real-de-al-menos-32-caracteres

# Vida útil de tokens (segundos). Defaults: access 900 (15 min), refresh 604800 (7 días).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Rate limit del login (intentos por ventana, por IP+email).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Contraseña de los usuarios ficticios del seed (mínimo 8 caracteres).
# Solo se usa con `npm run seed`; nunca se commitea un valor real.
SEED_PASSWORD=cambiar-esta-clave-ficticia

# ── Caja (C-11) ──────────────────────────────────────────────────────────────

# Zona horaria IANA para las fechas contables de caja (RN-09). La fecha de
# negocio NUNCA se deriva de la hora UTC ni de offsets fijos: se calcula con
# Intl usando esta zona. Los alias IANA válidos se aceptan (p. ej.
# "America/Argentina/Buenos_Aires"); una zona inexistente hace fallar el
# arranque con ConfigError. Default si se omite: America/Buenos_Aires.
CAJA_ZONA_HORARIA=America/Buenos_Aires

# ── Mercado Pago (C-11, EXCLUSIVAMENTE sandbox, sin cobros reales) ───────────

# Modo de la integración: SOLO se admite `sandbox`. Cualquier otro valor hace
# fallar el arranque con ConfigError (sin default silencioso).
MP_ENV=sandbox

# Access token de PRUEBA del servidor (dashboard de Mercado Pago modo
# sandbox). Es un ejemplo NO secreto: el valor real va en `.env` (gitignored).
# Sin token (o sin MP_WEBHOOK_SECRET) la integración queda deshabilitada:
# los cobros con medio mercadopago responden 503 mp_no_configurado y no se
# persiste ningún pago.
MP_ACCESS_TOKEN=TEST-token-de-ejemplo-no-real

# Secreto de firma del webhook de notificaciones (HMAC-SHA256 sobre
# x-signature / x-request-id / data.id, comparación en tiempo constante).
# Ejemplo NO secreto; el real va en `.env` (gitignored). Sin este valor la
# integración MP no habilita cobros ni confirmaciones.
MP_WEBHOOK_SECRET=secreto-de-ejemplo-no-real-para-firmar-webhooks
